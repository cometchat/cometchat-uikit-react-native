{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "jsx": "react-native",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "sourceMap": true,
    "target": "ESNext",
    "lib": ["ESNext", "DOM","ES6"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "lib",
    "declaration": true,
    "strict": true,
  },
  "include": ["src"]
}
